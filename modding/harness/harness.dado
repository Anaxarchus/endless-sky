package esmod

import sdk "../sdk/es"

// Loads mods and runs their hooks. One instance lives for the program; the
// game reaches it through the exports in entry.dado.
//
// A mod is a class extending the SDK's `es.Mod` (modding/sdk/es/Mod.dados),
// built as one bundled JavaScript file by `dado-mods.sh mod`. It is refused
// unless it reports the mod API version this game speaks. Then its `on_load`
// runs once and its `on_step` every step. A hook that fails is reported once and
// switched off for that mod, so one broken mod never stops the game or the
// other mods.
private class Harness:
    foreign "probe.js":
        bool has_method(any o, string name)

    Game game = Game()
    []LoadedMod mods = []

    // Load the mod whose JavaScript is `<path>.js`. Answers 0 when it loaded.
    int load(string path, string name):
        try any obj = Script.load(path) else e:
            game.log("dado: mod \"" + name + "\" did not load: " + e.message)
            return 1
        if !has_method(obj, "api_version"):
            game.log("dado: mod \"" + name + "\" was refused: it does not extend es.Mod")
            return 1
        try any version = obj.api_version() else e:
            game.log("dado: mod \"" + name + "\" was refused: " + e.message)
            return 1
        // The API only grows, so a mod built for this version or an earlier one runs.
        if int(version) < 1 || int(version) > sdk.MOD_API:
            game.log("dado: mod \"" + name + "\" was refused: it was built for mod API " + string(int(version)) + " and this game speaks up to " + string(sdk.MOD_API))
            return 1
        game.caller = name
        host_hook_timing(name, "on_load", true)
        try obj.on_load(game) else e:
            host_hook_timing(name, "on_load", false)
            game.log("dado: mod \"" + name + "\" failed in on_load and was not loaded: " + e.message)
            return 1
        host_hook_timing(name, "on_load", false)
        LoadedMod loaded = LoadedMod(name, obj)
        loaded.day_on = has_method(obj, "on_day")
        loaded.enter_on = has_method(obj, "on_enter")
        loaded.planet_on = has_method(obj, "on_planet_button")
        loaded.panel_on = has_method(obj, "on_panel")
        loaded.can_outfitter_on = has_method(obj, "can_outfitter")
        loaded.outfitter_on = has_method(obj, "on_outfitter")
        loaded.confirm_on = has_method(obj, "on_confirm")
        loaded.row_on = has_method(obj, "on_panel_row")
        loaded.number_on = has_method(obj, "on_number")
        loaded.header_on = has_method(obj, "on_panel_header")
        mods.append(loaded)
        game.log("dado: loaded mod \"" + name + "\"")
        return 0

    int count():
        return mods.len()

    void step(int n):
        for m in mods:
            if m.step_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_step", true)
                try m.obj.on_step(game, n) else e:
                    m.step_on = false
                    off(m, "on_step", e.message)
                host_hook_timing(m.name, "on_step", false)

    void day(int d):
        for m in mods:
            if m.day_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_day", true)
                try m.obj.on_day(game, d) else e:
                    m.day_on = false
                    off(m, "on_day", e.message)
                host_hook_timing(m.name, "on_day", false)

    void enter(string system):
        for m in mods:
            if m.enter_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_enter", true)
                try m.obj.on_enter(game, system) else e:
                    m.enter_on = false
                    off(m, "on_enter", e.message)
                host_hook_timing(m.name, "on_enter", false)

    // The player clicked the planet button mod `name` put up.
    void planet_button(string name):
        for m in mods:
            if m.name == name && m.planet_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_planet_button", true)
                try m.obj.on_planet_button(game) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_planet_button: " + e.message)
                host_hook_timing(m.name, "on_planet_button", false)

    // The player clicked button `button` of the panel mod `name` opened.
    void panel(string name, int button):
        for m in mods:
            if m.name == name && m.panel_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_panel", true)
                try m.obj.on_panel(game, button) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_panel: " + e.message)
                host_hook_timing(m.name, "on_panel", false)

    // Whether mod `name`'s outfitter button is enabled for `outfit`. A mod
    // built before mod API 5 has no button; one whose hook fails has it disabled.
    bool can_outfitter(string name, string outfit):
        for m in mods:
            if m.name == name:
                if !m.can_outfitter_on:
                    return m.outfitter_on
                game.caller = m.name
                host_hook_timing(m.name, "can_outfitter", true)
                try any answer = m.obj.can_outfitter(game, outfit) else e:
                    host_hook_timing(m.name, "can_outfitter", false)
                    m.can_outfitter_on = false
                    m.outfitter_on = false
                    off(m, "can_outfitter", e.message)
                    return false
                host_hook_timing(m.name, "can_outfitter", false)
                bool active = answer
                return active
        return false

    // The player clicked mod `name`'s outfitter button with `outfit` selected.
    void outfitter(string name, string outfit):
        for m in mods:
            if m.name == name && m.outfitter_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_outfitter", true)
                try m.obj.on_outfitter(game, outfit) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_outfitter: " + e.message)
                host_hook_timing(m.name, "on_outfitter", false)

    // The player confirmed what mod `name` asked with `token`.
    void confirm(string name, int token):
        for m in mods:
            if m.name == name && m.confirm_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_confirm", true)
                try m.obj.on_confirm(game, token) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_confirm: " + e.message)
                host_hook_timing(m.name, "on_confirm", false)

    // The player clicked row `row` of the table in mod `name`'s panel.
    void panel_row(string name, int row):
        for m in mods:
            if m.name == name && m.row_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_panel_row", true)
                try m.obj.on_panel_row(game, row) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_panel_row: " + e.message)
                host_hook_timing(m.name, "on_panel_row", false)

    // The player clicked heading `column` of the table on mod `name`'s screen.
    void panel_header(string name, int column):
        for m in mods:
            if m.name == name && m.header_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_panel_header", true)
                try m.obj.on_panel_header(game, column) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_panel_header: " + e.message)
                host_hook_timing(m.name, "on_panel_header", false)

    // The player answered mod `name`'s number dialog with `value`.
    void number(string name, int token, int value):
        for m in mods:
            if m.name == name && m.number_on:
                game.caller = m.name
                host_hook_timing(m.name, "on_number", true)
                try m.obj.on_number(game, token, value) else e:
                    game.log("dado: mod \"" + m.name + "\" failed in on_number: " + e.message)
                host_hook_timing(m.name, "on_number", false)

    void off(LoadedMod m, string hook, string why):
        game.log("dado: mod \"" + m.name + "\" failed in " + hook + " and its " + hook + " is now off: " + why)

// One loaded mod and which of its hooks are live.
private class LoadedMod:
    string name = ""
    any obj = 0
    bool step_on = true
    bool day_on = false
    bool enter_on = false
    bool planet_on = false
    bool panel_on = false
    bool can_outfitter_on = false
    bool outfitter_on = false
    bool confirm_on = false
    bool row_on = false
    bool number_on = false
    bool header_on = false

    void init(string n, any o):
        name = n
        obj = o
