class BadIndices extends es.Mod

// A test mod: asks about ships that do not exist and writes to them. The harness
// must answer zeros and ignore the writes rather than reach the game with them.

import "imports:sdk/es"

void on_step(es.Game game, int step):
    if game.condition("dado example: enabled") == 0:
        return
    int n = game.ship_count()
    game.set_hull(-1, 5.0)
    game.set_hull(n, 5.0)
    game.set_shields(1 << 40, 5.0)
    if game.hull(n) == 0.0 && game.ship_name(-7) == "" && !game.is_player(1 << 40):
        game.set_condition("test: bad indices ok", game.condition("test: bad indices ok") + 1)
