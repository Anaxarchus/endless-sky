class Api6Probe extends es.Mod

// A test mod for mod API 6: per-pilot storage, planets, panel tables and the
// number dialog. It records what it saw in conditions named "test: api6 ...",
// which test/fake_game.cpp checks. It does nothing unless the condition
// "test: api6" is non-zero, because the test mods are also copied into the real
// game's integration-test plugin.

import "imports:sdk/es"

string name():
    return "api6 probe"

bool enabled(es.Game game):
    return game.condition("test: api6") != 0

void rec(es.Game game, string key, int value):
    game.set_condition("test: api6 " + key, value)

void on_enter(es.Game game, string system):
    if !enabled(game):
        return
    game.planet_button("Probe 6")
    // Storage: any text comes back as it was, and "" removes the key.
    string tricky = "quote \" backtick ` percent % tab \t line\nend"
    game.set_data("state", tricky)
    rec(game, "data round trip", 1 if game.data("state") == tricky else 0)
    game.set_data("gone", "x")
    game.set_data("gone", "")
    rec(game, "data removed", 1 if game.data("gone") == "" && game.data("never") == "" else 0)
    // Planets.
    string here = game.planet()
    rec(game, "landed on " + here, 1)
    rec(game, "planets in Alpha " + string(game.planet_count("Alpha")), 1)
    for k in 0..<game.planet_count("Alpha"):
        string p = game.planet_at("Alpha", k)
        rec(game, "planet " + p + " " + game.planet_name(p) + " " + game.planet_system(p) + " " + game.planet_government(p), 1)
        rec(game, "bank " + p, 1 if game.planet_service(p, "bank") else 0)
    rec(game, "planet out of range", 1 if game.planet_at("Alpha", 9) == "" && game.planet_name("Nowhere") == "" else 0)

void on_planet_button(es.Game game):
    if !enabled(game):
        return
    game.panel_open("Exchange", "Pick a company.")
    game.panel_columns("Company\tPrice\tChange")
    game.panel_row("Acme\t12.50\t+3%")
    game.panel_row("Boreal\t8.00\t-1%")
    game.panel_button("Close")

void on_panel_row(es.Game game, int row):
    if !enabled(game):
        return
    rec(game, "row", row + 1)
    game.ask_number("How many shares?", 7, 500)

void on_number(es.Game game, int token, int value):
    if !enabled(game):
        return
    rec(game, "number token", token)
    rec(game, "number value", value)
