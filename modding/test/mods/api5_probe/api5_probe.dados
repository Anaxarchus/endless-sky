class Api5Probe extends es.Mod

// A test mod for mod API 5: the outfitter button, the fleet by UUID, outfits,
// integrating them, and confirm. It records what it saw in conditions named
// "test: api5 ...", which test/fake_game.cpp checks. It does nothing unless
// the condition "test: api5" is non-zero, because the test mods are also copied
// into the real game's integration-test plugin.

import "imports:sdk/es"

// The outfit on_outfitter asked about, until the player confirms.
string asked = ""

string name():
    return "api5 probe"

bool enabled(es.Game game):
    return game.condition("test: api5") != 0

void rec(es.Game game, string key, int value):
    game.set_condition("test: api5 " + key, value)

void on_enter(es.Game game, string system):
    if !enabled(game):
        return
    game.outfitter_button("Integrate")
    rec(game, "fleet " + string(game.fleet_count()), 1)
    for k in 0..<game.fleet_count():
        string ship = game.fleet_ship(k)
        rec(game, "ship " + string(k) + " " + ship + " " + game.fleet_ship_name(ship) + " " + game.fleet_ship_model(ship), 1)
    rec(game, "fleet out of range", 1 if game.fleet_ship(99) == "" && game.fleet_ship(-1) == "" else 0)
    rec(game, "laser " + game.outfit_name("Laser") + " " + game.outfit_category("Laser"), 1)
    rec(game, "laser mass", int(game.outfit_attribute("Laser", "mass")))
    rec(game, "laser cost", int(game.outfit_attribute("Laser", "cost")))
    rec(game, "battery energy", int(game.outfit_attribute("Battery", "energy capacity")))
    rec(game, "laser weapon", 1 if game.outfit_is_weapon("Laser") else 0)
    rec(game, "battery weapon", 1 if game.outfit_is_weapon("Battery") else 0)
    rec(game, "unknown outfit", 1 if game.outfit_name("Nope") == "" && game.outfit_attribute("Nope", "mass") == 0.0 else 0)
    rec(game, "no outfitter ships", 1 if game.outfitter_ship_count() == 0 && game.outfitter_ship(0) == "" else 0)
    // Not a hook the player started: this must do nothing.
    game.confirm("Too early", 1)

bool can_outfitter(es.Game game, string outfit):
    if !enabled(game):
        return false
    rec(game, "can asked", game.condition("test: api5 can asked") + 1)
    rec(game, "selected " + string(game.outfitter_ship_count()), 1)
    if outfit == "" || game.outfitter_ship_count() == 0:
        return false
    string ship = game.outfitter_ship(0)
    return game.ship_outfit_count(ship, outfit) > game.ship_integrated_count(ship, outfit)

void on_outfitter(es.Game game, string outfit):
    if !enabled(game):
        return
    asked = outfit
    rec(game, "clicked " + outfit, 1)
    game.confirm("Integrate the " + game.outfit_name(outfit) + "?", 7)

void on_confirm(es.Game game, int token):
    if !enabled(game):
        return
    rec(game, "confirmed", token)
    string ship = game.outfitter_ship(0)
    bool ok = game.ship_integrate(ship, asked, 0.75)
    rec(game, "integrated " + asked, 1 if ok else 0)
    rec(game, "integrated count " + asked, game.ship_integrated_count(ship, asked))
    rec(game, "ammo refused", 1 if !game.ship_integrate(ship, "Gat Ammo", 0.75) else 0)
    rec(game, "bad scale refused", 1 if !game.ship_integrate(ship, asked, 1.5) else 0)
