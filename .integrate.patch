From d1b4902568e2c4b66a4dceb19a591b97238e87c7 Mon Sep 17 00:00:00 2001
From: Anaxarchus <mcclureisamuel@gmail.com>
Date: Thu, 29 Oct 2026 20:41:40 -0800
Subject: [PATCH] Integrated outfits save weapon and engine capacity too

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H9LHWdhov7eiJ4GLVC1UDh
---
 source/Ship.cpp                               | 13 ++--
 tests/CMakeLists.txt                          |  1 +
 .../data/tests/tests_integrated_outfits.txt   | 75 +++++++++++++++++++
 3 files changed, 84 insertions(+), 5 deletions(-)
 create mode 100644 tests/integration/config/plugins/integration-tests/data/tests/tests_integrated_outfits.txt

diff --git a/source/Ship.cpp b/source/Ship.cpp
index be68da16c..60bd3528d 100644
--- a/source/Ship.cpp
+++ b/source/Ship.cpp
@@ -4308,14 +4308,17 @@ Outfit Ship::IntegrationSavings(const Outfit &outfit, double reduction, int coun
 	Outfit savings;
 	if(count <= 0 || reduction <= 0.)
 		return savings;
-	// Each outfit saves a whole number of tons and of outfit space (rounding a
-	// half up). Capacities (weapon, engine, cargo) are left as they are.
+	// Each outfit saves a whole number of tons and of the outfit, weapon and
+	// engine space it uses (rounding a half up). Hardpoints are left as they are.
 	const double share = reduction / count;
 	if(outfit.Mass() > 0.)
 		savings.AddMass(-round(outfit.Mass() * share) * count);
-	double used = outfit.Get("outfit space");
-	if(used < 0.)
-		savings.Set("outfit space", round(-used * share) * count);
+	for(const char *space : {"outfit space", "weapon capacity", "engine capacity"})
+	{
+		double used = outfit.Get(space);
+		if(used < 0.)
+			savings.Set(space, round(-used * share) * count);
+	}
 	return savings;
 }
 
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 62f911a45..cdc2d6aa6 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -77,6 +77,7 @@ list(APPEND INTEGRATION_TESTS
 	integration/config/plugins/integration-tests/data/tests/tests_to_accept.txt
 	integration/config/plugins/integration-tests/data/tests/tests_wormhole_navigation.txt
 	integration/config/plugins/integration-tests/data/tests/tests_installed_plugin.txt
+	integration/config/plugins/integration-tests/data/tests/tests_integrated_outfits.txt
 )
 
 target_include_directories(EndlessSkyTests PRIVATE unit/include)
diff --git a/tests/integration/config/plugins/integration-tests/data/tests/tests_integrated_outfits.txt b/tests/integration/config/plugins/integration-tests/data/tests/tests_integrated_outfits.txt
