+
+const Ship *ShipyardPanel::BaseModel(const Ship &ship) const
+{
+	// Variants count as their base model. (The variant name is not saved with
+	// the player's ships, so using it would make selling behave differently
+	// after a reload.)
+	const Ship *model = GameData::Ships().Find(ship.TrueModelName());
+	return (model && model->IsValid()) ? model : nullptr;
+}
+
+
+
+int ShipyardPanel::Used(const Ship *model) const
+{
+	const Ship *base = model ? BaseModel(*model) : nullptr;
+	return base ? player.ShipInStock(base) : 0;
 }
 
 
