 int ShipyardPanel::Available(const Ship *model) const
 {
-	return Stock(model);
+	// A model not sold here is listed only for its own used hulls.
+	if(!shipyard.Has(model))
+		return player.ShipInStock(model);
+	int used = Used(model);
+	int shelf = Stock(model);
+	if(shelf < 0)
+		return -1;
+	return static_cast<int>(min<int64_t>(static_cast<int64_t>(shelf) + used, numeric_limits<int>::max()));
 }
 
 
 
 string ShipyardPanel::StockLabel(const Ship *model, bool isDetails) const
 {
-	int total = Available(model);
-	if(total < 0)
-		return "";
-	if(!total)
-		return isDetails ? "Out of stock" : "out of stock";
-	return isDetails ? "In stock: " + to_string(total) : to_string(total) + " in stock";
+	int used = shipyard.Has(model) ? Used(model) : player.ShipInStock(model);
+	int shelf = shipyard.Has(model) ? Stock(model) : -1;
+	if(shelf >= 0)
+	{
+		int total = Available(model);
+		if(!total)
+			return isDetails ? "Out of stock" : "out of stock";
+		string label = isDetails ? "In stock: " + to_string(total) : to_string(total) + " in stock";
+		if(used)
+			label += " (" + to_string(used) + " used)";
+		return label;
+	}
+	if(used)
+		return isDetails ? "In stock: " + to_string(used) + " used" : to_string(used) + " used in stock";
+	return "";
+}
