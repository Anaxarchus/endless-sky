+int PlayerInfo::ShipInStock(const Ship *model) const
+{
+	auto it = shipInStock.find(model);
+	return (it == shipInStock.end() ? 0 : it->second);
+}
+
+
+
+// Unlike AddStock(), this does not touch the depreciation records: SellShip()
+// and BuyShip() already move the hull's record between the fleet and the stock.
+void PlayerInfo::AddShipInStock(const Ship *model, int count)
+{
+	if(!model || !model->IsValid())
+		return;
+	int64_t total = static_cast<int64_t>(ShipInStock(model)) + count;
+	if(total <= 0)
+		shipInStock.erase(model);
+	else
+		shipInStock[model] = static_cast<int>(min<int64_t>(total, numeric_limits<int>::max()));
+}
