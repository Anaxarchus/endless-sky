+		// When landed, take what the cargo hold lacks from storage on this planet.
+		bool didStorage = false;
+		if(count < 0 && player.GetPlanet())
+		{
+			CargoHold &storage = player.Storage();
+			int stored = storage.Get(outfit);
+			if(stored)
